# =====================================================================
# BASE DE DATOS POSTGRESQL (DOCKER COMPOSE & SPRING BOOT)
# =====================================================================
POSTGRES_DB=polink_db
POSTGRES_USER=polink_user
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD
POSTGRES_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/polink_db

# =====================================================================
# SERVIDOR BACKEND & CORS
# =====================================================================
SERVER_PORT=8080
FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# =====================================================================
# SEGURIDAD JWT & RECUPERACION DE CONTRASENA
# =====================================================================
JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_64_BYTES_BASE64_OR_HEX_SECRET_KEY_FOR_HS256
JWT_EXPIRATION_MS=86400000
PASSWORD_RESET_EXPIRATION_MINUTES=30

# =====================================================================
# CORREO ELECTRONICO (MAILPIT EN LOCAL / SMTP EN PRODUCCION)
# =====================================================================
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@polink.local
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# =====================================================================
# ALMACENAMIENTO DE IMAGENES (local | cloudinary)
# =====================================================================
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =====================================================================
# CUENTAS INICIALES SEMILLA (OPCIONALES PARA DESARROLLO)
# =====================================================================
SEED_ADMIN_EMAIL=admin@polink.edu.co
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SEED_SUPERVISOR_EMAIL=supervisor@polink.edu.co
SEED_SUPERVISOR_PASSWORD=CHANGE_ME_SUPERVISOR_PASSWORD
